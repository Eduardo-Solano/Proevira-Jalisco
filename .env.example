# ── Proyecto y API FastAPI ──
PROJECT_NAME="Proevira Jalisco - Sistema de Vigilancia Epidemiológica"
API_V1_PREFIX=/api/v1
DEBUG=false

# ── Base de datos (SQLite local o PostgreSQL en producción) ──
DATABASE_URL=sqlite:///./proevira.db

# ── Seguridad JWT (OBLIGATORIO cambiar en producción) ──
JWT_SECRET_KEY=CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_MINIMO_32_CARACTERES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS (lista JSON de orígenes permitidos en producción) ──
CORS_ORIGINS=["http://127.0.0.1:8501","http://localhost:8501"]

# ── Firebase Admin SDK (opcional; si se omite se usa únicamente JWT local) ──
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# ── Dashboard Web Streamlit ──
API_BASE_URL=http://127.0.0.1:8000/api/v1
WS_BASE_URL=ws://127.0.0.1:8000/ws/alerts
PROEVIRA_DEMO_MODE=false

